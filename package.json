    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.545.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
